{
  "manifest_version": 3,
  "name": "Jellyneo Price Lookup",
  "version": "1.1.0",
  "description": "Looks up Jellyneo prices from the popup. Reads item names only on neopets.com, without changing the page or contacting Neopets.",
  "key": "",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": [
    "https://items.jellyneo.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Jellyneo Price Lookup",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
